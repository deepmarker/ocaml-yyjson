# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml bindings to the yyjson C JSON parser"
description:
  "Bindings to yyjson, a fast C JSON parser. Values are unboxed pointers into the parsed document, so reading fields allocates nothing beyond what is extracted. Provides direct accessors for reading individual members, exact 64-bit integer accessors, and a generic Json_repr-compatible view for json-data-encoding interop. Requires yyjson >= 0.13.0 as a system library."
maintainer: ["Vincent Bernardoff <vbmithr@gmail.com>"]
authors: ["Vincent Bernardoff <vbmithr@gmail.com>"]
license: "ISC"
tags: ["json" "yyjson" "parser" "bindings"]
homepage: "https://github.com/deepmarker/ocaml-yyjson"
doc: "https://github.com/deepmarker/ocaml-yyjson"
bug-reports: "https://github.com/deepmarker/ocaml-yyjson/issues"
depends: [
  "ocaml"
  "dune" {>= "3.5"}
  "bigstringaf"
  "alcotest" {with-test}
  "base" {with-test}
  "sexplib" {with-test}
  "json-data-encoding" {with-test}
  "ppx_sexp_conv" {with-test}
  "ppx_compare" {with-test}
  "ezjsonm" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/deepmarker/ocaml-yyjson.git"
